{
  "name": "generate_study_site",
  "description": "Scaffold a static study site from one course config. Pass the config fields as the arguments. Required: siteTitle, course, throughline, textbook, maps, threads, stations. Do not call when textbook.title is missing, TODO, or a placeholder: ask for the title, authors, edition, and a URL or chapter list first. Each station needs summary, observe, and source with chapter and section. A problem needs hint, answer { tex, text, values }, station, and source.exercise. A concept needs station and the same section as that station. visualization is only \"two-addresses\" (a complex point; it talks about Arg and the seam) or \"number-line\" (one real number, up to 3 preset chips). Any other picture is kind \"custom\" plus a module path you have already written. kind \"reading\" is an unfinished placeholder, not a finished stop. colourKeys text is this course's words for the tokens cart, polar, input, and output. Do not copy Cartesian or Arg onto a course that is not about them. Config loop is camelCase: reframeRounds and reframers. Do not put reframe_rounds inside the config. This call only writes the folder. It does not draw custom pictures, recompute answers, or run reviewers. After the folder exists, build in batches of 2 to 4 rounds, then close, then mid, then wide, then at most 3 reframe rounds of 3 independent reframers, one rebuttal each, and a council. Reviewers decide. They do not ask the user. The only ask is a missing textbook, and that happens before this call.",
  "loop": {
    "batch_rounds": { "min": 2, "max": 4 },
    "reviewers": ["close", "mid", "wide"],
    "reframe_rounds": 3,
    "reframers": 3,
    "reframe_log": "REFRAME_LOG.md",
    "research_log": "RESEARCH_LOG.md",
    "stop_when": "convergence",
    "ask_user": false,
    "ask_user_only_when": "textbook.title is missing"
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["siteTitle", "course", "throughline", "textbook", "maps", "threads", "stations"],
    "properties": {
      "siteTitle": { "type": "string", "description": "The name in the header and the browser tab." },
      "course": { "type": "string", "description": "Course code or name, such as MAT 412." },
      "tagline": { "type": "string" },
      "description": { "type": "string", "description": "One sentence for the meta description." },
      "throughline": { "type": "string", "description": "The one idea the whole site teaches, across every test and map." },
      "storagePrefix": { "type": "string", "description": "localStorage prefix. Default study:. Do not reuse another site's prefix on the same origin.", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,24}$" },
      "footer": { "type": "string" },
      "footerByMap": { "type": "object", "additionalProperties": { "type": "string" } },
      "ledeByMap": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Home-page sentence per map. Each map gets its own lede. The throughline still governs every page." },
      "textbook": {
        "type": "object",
        "required": ["title"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 3, "description": "The course textbook, or the course handout when that is the actual text. Empty, TODO, or a placeholder is invalid. The scaffold exits 2 and the agent asks." },
          "authors": { "type": "array", "items": { "type": "string" } },
          "edition": { "type": "string" },
          "url": { "type": "string", "description": "Primary link. Use the HTML edition when both exist." },
          "htmlUrl": { "type": "string", "description": "HTML edition." },
          "pdfUrl": { "type": "string", "description": "PDF edition." },
          "licence": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "1 when the user named the book. Below 1, note must say what is still uncertain. A missing title still means stop and ask." },
          "note": { "type": "string" }
        }
      },
      "chapters": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title"],
          "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "sections": { "type": "array", "items": { "type": "string" } },
            "url": { "type": "string" },
            "note": { "type": "string" }
          }
        }
      },
      "maps": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "title": { "type": "string" },
            "note": { "type": "string" }
          }
        }
      },
      "parts": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string" },
            "note": { "type": "string" }
          }
        }
      },
      "threads": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "tone", "mark"],
          "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "summary": { "type": "string" },
            "tone": { "type": "string", "enum": ["cart", "polar", "input", "output", "accent"] },
            "mark": { "type": "string", "enum": ["disc", "ring", "diamond"] },
            "maps": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "colourKeys": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "text"],
            "properties": {
              "role": { "type": "string", "enum": ["cart", "polar", "input", "output", "seam", "ramp"] },
              "text": { "type": "string" }
            }
          }
        }
      },
      "palette": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "light": { "$ref": "#/$defs/paletteMode" },
          "dark": { "$ref": "#/$defs/paletteMode" }
        }
      },
      "stations": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/station" }
      },
      "concepts": {
        "type": "array",
        "items": { "$ref": "#/$defs/concept" }
      },
      "flashcards": {
        "type": "array",
        "items": { "$ref": "#/$defs/flashcard" }
      },
      "problems": {
        "type": "array",
        "items": { "$ref": "#/$defs/problem" }
      },
      "loop": {
        "type": "object",
        "additionalProperties": false,
        "description": "CamelCase caps in the config. The top-level loop object on this file is the same procedure in snake_case. Do not put reframe_rounds in the config.",
        "properties": {
          "batchRounds": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min": { "type": "integer", "minimum": 2, "maximum": 4, "default": 2 },
              "max": { "type": "integer", "minimum": 2, "maximum": 4, "default": 4 }
            }
          },
          "reviewers": {
            "type": "array",
            "items": { "type": "string", "enum": ["close", "mid", "wide"] },
            "minItems": 3,
            "maxItems": 3
          },
          "reframeRounds": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3, "description": "Cap on zoom-out rounds. Stop earlier when pitches converge." },
          "reframers": { "type": "integer", "minimum": 2, "maximum": 3, "default": 3, "description": "Independent reframer agents per zoom-out round." }
        }
      }
    },
    "$defs": {
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chapter", "section"],
        "properties": {
          "chapter": { "type": "number", "description": "Textbook chapter. Use 0 only when the idea is outside the numbered chapters, and say so in note." },
          "section": { "type": "string", "minLength": 1 },
          "sectionTitle": { "type": "string" },
          "exercise": { "type": "string", "minLength": 1, "description": "Required on problems. The handout's number when it is not a confirmed book exercise, and then say so in note." },
          "url": { "type": "string", "description": "Section URL. The source tag links here when it is set." },
          "note": { "type": "string" }
        }
      },
      "problemSource": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chapter", "section", "exercise"],
        "properties": {
          "chapter": { "type": "number" },
          "section": { "type": "string", "minLength": 1 },
          "sectionTitle": { "type": "string" },
          "exercise": { "type": "string", "minLength": 1 },
          "url": { "type": "string" },
          "note": { "type": "string" }
        }
      },
      "answer": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tex", "text", "values"],
        "properties": {
          "tex": { "type": "string", "minLength": 1, "description": "Prose the learner reads, with $...$ around TeX." },
          "text": { "type": "string", "minLength": 1, "description": "The same answer in plain text. No $ and no TeX commands." },
          "values": {
            "type": "object",
            "description": "Named numbers a test recomputes. {} only when the answer has no number.",
            "additionalProperties": { "type": "number" }
          }
        }
      },
      "paletteMode": {
        "type": "object",
        "propertyNames": {
          "enum": ["bg", "surface", "surface-2", "text", "text-muted", "border", "border-strong", "accent", "on-accent", "focus", "cart", "polar", "input", "output", "seam", "t0", "t1", "ok", "warn", "danger"]
        },
        "additionalProperties": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" }
      },
      "station": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "summary", "observe", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string" },
          "kind": { "type": "string", "enum": ["map", "reading", "viz", "flashcards", "practice", "custom"], "description": "reading is an unfinished placeholder. A finished teaching stop is viz or custom. Exactly one station is map. flashcards is the one-card deck. practice is the question list." },
          "visualization": { "type": "string", "enum": ["two-addresses", "number-line"], "description": "Built-in pictures. Any other picture is a custom station. Do not fake it." },
          "module": { "type": "string", "description": "Only for kind custom. A path like ./stations/julia.js." },
          "map": { "type": "string", "description": "A map id, or shared for a stop that sits on every map." },
          "part": { "type": "string" },
          "partByMap": { "type": "object", "additionalProperties": { "type": "string" } },
          "order": { "type": "number" },
          "threads": { "type": "array", "items": { "type": "string" } },
          "threadsByMap": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
          "topics": { "type": "array", "items": { "type": "string" } },
          "problems": { "type": "array", "items": { "type": "string" } },
          "summary": { "type": "string" },
          "observe": { "type": "string", "description": "What the learner should look at on this page." },
          "tie": { "type": "string", "description": "Optional sentence that places the stop on the map. The shell writes one if this is empty." },
          "chapter": { "type": "number" },
          "source": { "$ref": "#/$defs/source" },
          "viz": { "$ref": "#/$defs/viz" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "viz" } }, "required": ["kind"] },
            "then": {
              "properties": { "visualization": { "enum": ["two-addresses", "number-line"] } },
              "required": ["visualization"]
            }
          },
          {
            "if": { "properties": { "kind": { "const": "custom" } }, "required": ["kind"] },
            "then": {
              "properties": { "module": { "type": "string", "pattern": "^\\./" } },
              "required": ["module"]
            }
          }
        ]
      },
      "viz": {
        "type": "object",
        "additionalProperties": false,
        "description": "Start value and sentence for a built-in picture. Preset chips are controls. At most 3.",
        "properties": {
          "start": {
            "oneOf": [
              { "type": "number" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["re", "im"],
                "properties": {
                  "re": { "type": "number" },
                  "im": { "type": "number" }
                }
              }
            ]
          },
          "sentence": { "type": "string" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "presets": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "re": { "type": "number" },
                "im": { "type": "number" },
                "x": { "type": "number" }
              }
            }
          }
        }
      },
      "concept": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "station", "source"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "station": { "type": "string" },
          "summary": { "type": "string" },
          "source": { "$ref": "#/$defs/source" }
        }
      },
      "flashcard": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "front", "back", "source"],
        "properties": {
          "id": { "type": "string" },
          "front": { "type": "string" },
          "back": { "type": "string" },
          "station": { "type": "string" },
          "threads": { "type": "array", "items": { "type": "string" } },
          "source": { "$ref": "#/$defs/source" }
        }
      },
      "problem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "hint", "answer", "station", "source"],
        "properties": {
          "id": { "type": "string" },
          "chapter": { "type": "number" },
          "statement": { "type": "string", "description": "Prose with $...$ for math." },
          "hint": { "type": "string" },
          "answer": { "$ref": "#/$defs/answer" },
          "station": { "type": "string" },
          "threads": { "type": "array", "items": { "type": "string" } },
          "source": { "$ref": "#/$defs/problemSource" }
        }
      }
    }
  }
}
